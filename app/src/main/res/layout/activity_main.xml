<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.ld.tubeld.RadialView
                android:id="@+id/viz"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="Sin anuncios"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Modo día o noche"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sun" />

            <ImageButton
                android:id="@+id/btnExit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Salir"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_power" />
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_gold" />

        <ProgressBar
            android:id="@+id/bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressTint="@color/gold" />

        <com.ld.tubeld.BgWebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:elevation="14dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bar_bg"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                android:src="@drawable/ic_back" />
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_home" />
            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Recargar"
                android:src="@drawable/ic_refresh" />
            <ImageButton
                android:id="@+id/btnAds"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bloqueo de anuncios"
                android:src="@drawable/ic_shield" />
            <ImageButton
                android:id="@+id/btnBg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Segundo plano"
                android:src="@drawable/ic_headphones" />
            <ImageButton
                android:id="@+id/btnEq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ecualizador"
                android:src="@drawable/ic_eq" />
            <ImageButton
                android:id="@+id/btnTimer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Temporizador"
                android:src="@drawable/ic_timer" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Puntero para el control remoto (solo en Smart TV) -->
    <com.ld.tubeld.CursorView
        android:id="@+id/cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pantalla inicial: se ve al abrir y se va cuando YouTube ya cargó -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0B0F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashMark"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_splash" />

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="YouTube sin anuncios, con audio de fondo"
            android:textColor="#7A7A88"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
