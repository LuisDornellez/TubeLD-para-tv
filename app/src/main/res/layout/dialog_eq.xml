<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ecualizador"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swEq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ajusta el sonido a tu gusto"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/eqPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="false"
                app:singleLine="true"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </HorizontalScrollView>

        <com.ld.tubeld.EqBandsView
            android:id="@+id/eqBands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Graves"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slBass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envolvente (se nota más con auriculares)"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slWide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claridad (voces y agudos)"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slClarity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivelar volumen (sin saltos entre voces y explosiones)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sincronía y estabilidad: izquierda = sonido pegado a la imagen, derecha = menos trabas"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slBuf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="2" />

        <Button
            android:id="@+id/btnEqReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Restablecer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
